# ── Context Agent Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# The system reads from environment variables with sensible defaults.

# ── Groq API (cloud LLM provider) ───────────────────────────────────
# Get your key at: https://console.groq.com/keys
# Set USE_GROQ=True in config.py to enable.
GROQ_API_KEY=your_groq_api_key_here

# ── Google Gemini (cloud LLM provider) ──────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
# Set USE_GEMINI=True in config.py to enable.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Ollama (local LLM — default) ────────────────────────────────────
# No API key needed. Just install Ollama: https://ollama.com
# Pull a model: ollama pull qwen2.5-coder:14b
